---
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/blog.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  current?: 'blog';
}

const { current, ...seo } = Astro.props;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <Seo {...seo} />
    <meta name="theme-color" content="#0d1120" />
    <link rel="icon" href="/assets/banksman-icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/assets/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <link rel="preload" href="/assets/fonts/big-shoulders-display-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/ibm-plex-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/assets/site.css" />
<script
    id="Cookiebot"
    src="https://consent.cookiebot.com/uc.js"
    data-cbid="5cdf60c9-01d0-4d98-bb5f-20ee58081cff"
    data-blockingmode="auto"
    type="text/javascript"
  ></script>
<!-- Meta Pixel Code -->
<script is:inline type="text/plain" data-cookieconsent="marketing">
!function(f,b,e,v,n,t,s)
{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
n.callMethod.apply(n,arguments):n.queue.push(arguments)};
if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
n.queue=[];t=b.createElement(e);t.async=!0;
t.src=v;s=b.getElementsByTagName(e)[0];
s.parentNode.insertBefore(t,s)}(window, document,'script',
'https://connect.facebook.net/en_US/fbevents.js');
fbq('init', '1178352088183069');
fbq('track', 'PageView');
</script>
<noscript><img height="1" width="1" style="display:none"
src="https://www.facebook.com/tr?id=1178352088183069&ev=PageView&noscript=1"
/></noscript>
<!-- End Meta Pixel Code -->
    <script is:inline src="/assets/consent.js"></script>
  </head>
  <body>
    <Header current={current} />
    <main id="top">
      <slot />
    </main>
    <Footer />
    <script is:inline src="/assets/site.js" defer></script>
  </body>
</html>
